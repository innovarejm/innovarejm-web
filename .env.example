# Copia este archivo como .env.local para desarrollo, y crea las mismas variables en
# Vercel → Settings → Environment Variables para producción. Nunca subas .env.local a git.

# Meta Pixel (el código incluye el Pixel oficial de INNOVARE JM como valor por defecto).
VITE_META_PIXEL_ID=1070478956041972

# Google Analytics 4. Si se deja vacío, analytics.js usa G-V98GH9N1H4 (propiedad "Innovare JM Web").
VITE_GA_ID=

# Captura de leads del checkout hacia el CRM (solo servidor, nunca en el navegador).
# LEADS_WEBHOOK_SECRET debe coincidir con el del CRM. CRM_WEBHOOK_URL es opcional.
LEADS_WEBHOOK_SECRET=
CRM_WEBHOOK_URL=https://crm.5dagency.pro/api/webhooks/leads/

# URL pública del sitio, para enlaces absolutos en el sitemap y al compartir (opcional:
# en Vercel se usa automáticamente el dominio de producción).
SITE_URL=

# Calendarios iCal de Airbnb (Calendario → Disponibilidad → Exportar calendario)
ICAL_BOCAGRANDE_1601=
ICAL_BOCAGRANDE_1604=
ICAL_RODADERO_901=
ICAL_DARIEN_VILLA_SONADA=
